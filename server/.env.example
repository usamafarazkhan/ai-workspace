# ============================================================
# multim-project — API Keys Configuration Template
# ============================================================
# Copy this file to .env and insert your real keys.
# NEVER commit your actual .env file with live keys to GitHub!
# ============================================================

# ── OPENAI (GPT-4o, GPT-4o-mini) ───────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── GOOGLE GEMINI (gemini-2.0-flash, gemini-1.5-pro) ────────
# Get key: https://aistudio.google.com/apikey  (FREE)
GEMINI_API_KEY=

# ── ANTHROPIC CLAUDE (claude-3-5-sonnet) ────────────────────
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ============================================================
# DEFAULT MODEL SETTINGS
# ============================================================
DEFAULT_MODEL=gpt-4o-mini

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=sqlite+aiosqlite:///./workspace.db

# ============================================================
# APP SECURITY
# ============================================================
APP_SECRET_KEY=multim-project-secret-key-change-in-production-2024
